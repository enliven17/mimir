# Copy this to .env.local and set your actual database variables.
# DATABASE_URL should point to your PostgreSQL/Neon/Supabase database.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# The deployed Mimir contract address on Arc Testnet.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional override for Arc RPC. If the default node is rate-limited, set this
# to an alternate testnet endpoint. The app tries the following in order:
# 1) NEXT_PUBLIC_ARC_RPC (this value)
# 2) ARC_RPC (server-only env var)
# 3) community node: https://arc-node.thecanteenapp.com (recommended fallback)
# 4) the chain default: https://rpc.testnet.arc.network
#
# Example (uncomment to use):
# NEXT_PUBLIC_ARC_RPC=https://arc-node.thecanteenapp.com

# Cron secret for /api/cron/sync endpoint authorization.
# Set this in production environment (never commit it).
# CRON_SECRET=your-random-secret-here

# Optional RPC tuning (defaults are conservative for Arc's rate-limited RPC):
# ARC_LOG_CONCURRENCY=6     # concurrent eth_getLogs chunks (default: 6)
# NEXT_PUBLIC_RPC_BATCH_SIZE=5  # JSON-RPC batch size (default: 5)
# Increase these if using a dedicated RPC provider; reduce further if hitting 429s.
